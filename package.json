{
  "name": "product-factory-console",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-shell.mjs",
    "check": "prettier --check \"src/**/*.{ts,html}\" \"tests/**/*.{ts,js,mjs}\" \"scripts/*.mjs\" \"*.mjs\" \"*.json\" && eslint . && tsc --noEmit && vitest run",
    "test:e2e": "node -e \"console.log('No end-to-end suite configured yet.')\"",
    "test:golden": "node -e \"console.log('No golden suite configured yet.')\"",
    "package": "node -e \"console.log('No installer packaging configured yet.')\""
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "electron": "45.5.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
